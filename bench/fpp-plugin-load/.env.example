# Bench scaffolding, not the product. Copy to .env and adjust, or pass the
# equivalent flags to scripts/test-plugin-load-fpp.sh; every setting here
# has a working default, so an empty/absent .env is also fine to start
# with. See README.md for the full flag list.

# Isolates one run from another: the compose project name, the container
# name, the network, and the named media volume all carry this value, so
# two concurrent runs with different BENCH_ID never collide.
BENCH_ID=local

# Host port for the container's port 80 (apache, proxying fppd's HTTP API).
# Deliberately not 8090, the sibling fpp-multisync bench's default, so the
# two benches can run at the same time without a port collision.
BENCH_HTTP_PORT=8190

# Which FPP major to stand up: fpp9 or fpp10. Selects the pinned image tag,
# commit, and adapter build target; see native/adapters/FPP-PINS.md for the
# exact pins this resolves to.
BENCH_FPP_MAJOR=fpp9

# Container CPU type: amd64 or arm64. Default amd64, so existing recorded
# results keep their meaning. arm64 is a native run on Apple Silicon and
# other arm64 hosts; the image tag is suffixed "-arm64" so it never collides
# with an amd64 build of the same FPP tag.
BENCH_CPU=amd64

# Set to 1 (or pass --prebuilt) to use a private prebuilt FPP fixture image
# instead of building from source. FPP 9 only; see docker-compose.prebuilt.yml.
# Requires FPP_PREBUILT_IMAGE below.
BENCH_USE_PREBUILT=0

# Exact digest reference for the prebuilt fixture image, required only when
# BENCH_USE_PREBUILT=1. Not reachable from every machine; see
# docker-compose.prebuilt.yml's header for what was actually observed when
# this bench was built.
FPP_PREBUILT_IMAGE=
